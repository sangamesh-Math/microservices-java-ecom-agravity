            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sony WH-1000XM5 Wireless Headphones\",\n  \"description\": \"Industry Leading Noise Canceling with 2 Processors and 8 Microphones\",\n  \"price\": 399.99,\n  \"stockQuantity\": 50,\n  \"category\": \"Audio\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1505740420928-5e560c06d30e\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "header": [],
